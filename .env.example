# Postgres (e.g. Neon). DATABASE_URL = pooled (-pooler) for runtime, DIRECT_URL = direct for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"

# Canonical site URL — used to build links in emails (password reset, etc.).
# Set this in production to your real domain so reset links never point at localhost.
# Leave UNSET locally so dev links fall back to http://localhost:3000.
APP_URL="https://"

# Email — choose ONE transport:
#
# Option A (recommended, free, sends to anyone): Gmail SMTP.
#   SMTP_USER = your full Gmail address
#   SMTP_PASS = a Gmail "App Password" (16 chars) — NOT your normal password.
#               Create at https://myaccount.google.com/apppasswords (needs 2FA on).
SMTP_USER="yourname@gmail.com"
SMTP_PASS="xxxxxxxxxxxxxxxx"
# EMAIL_FROM defaults to "BuyME <SMTP_USER>"; override if you like.
EMAIL_FROM="BuyME <yourname@gmail.com>"
#
# Option B (Resend): only delivers to your own address until you verify a domain.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Google OAuth
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"

# Stripe payments (optional — without these, checkout falls back to direct order
# placement). Get keys at https://dashboard.stripe.com/apikeys.
#   STRIPE_SECRET_KEY     — sk_test_... (test mode) or sk_live_... (real charges)
#   STRIPE_WEBHOOK_SECRET — whsec_... from the webhook endpoint or `stripe listen`
#   STRIPE_CURRENCY       — charge currency. Use "eur" for the German/EU market.
#
# Local payment methods (Klarna, PayPal, SEPA Direct Debit, cards, giropay) are NOT
# hard-coded here — Checkout shows whichever methods you enable in the Stripe
# Dashboard (Settings → Payment methods) that are eligible for the currency above.
# For Germany: set STRIPE_CURRENCY="eur" and enable Card, Klarna, PayPal & SEPA there.
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
STRIPE_CURRENCY="eur"

# Shopping assistant (chat widget). Powered by Google Gemini (free tier — no card).
# Create a key at https://aistudio.google.com/app/apikey
# Without this, the widget still renders but replies that it isn't configured.
GEMINI_API_KEY="AIzaxxxxx"
# Optional model override (defaults to gemini-2.5-flash, which has free quota
# where gemini-2.0-flash often doesn't). Run `node scripts/test-gemini.mjs` to
# see which models your key can use.
GEMINI_MODEL="gemini-2.5-flash"
